---
/**
 * base-layout.astro
 * Common <head>, metadata, global CSS imports, dot matrix background,
 * and header bar. Wraps every page so the background and header
 * appear consistently across the entire app.
 */
import "../styles/global.css";
import { registerLocale, t, langAttr, localeFromUrl } from "@lib/i18n";
import type { Locale } from "@lib/i18n";
import en from "../locales/en.json";
import ja from "../locales/ja.json";
import ko from "../locales/ko.json";
import vi from "../locales/vi.json";
import DotMatrixBackground from "@components/islands/shared/dot-matrix-background";
import LanguageSelector from "@components/islands/shared/language-selector";
import RoleLinks from "@components/islands/shared/role-links";
import type { GradientPreset } from "@components/islands/shared/dot-matrix-background";
import { MAIN, HEADER_BAR, BRAND } from "@lib/classes";

// Register all locales at module scope (idempotent)
registerLocale("en", en);
registerLocale("ja", ja);
registerLocale("ko", ko);
registerLocale("vi", vi);

export interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
  /** Dot-matrix background gradient preset. Defaults to `cyan-blue`. */
  gradient?: GradientPreset;
}

const {
  title: titleOverride,
  description: descriptionOverride,
  lang: locale = "en",
  gradient = "cyan-blue",
} = Astro.props;

const lang = langAttr(locale);
const pageTitle = titleOverride ?? t(locale, "site.title");
const pageDescription = descriptionOverride ?? t(locale, "site.description");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    {/* Dot matrix particle background (fixed, behind all content) */}
    <DotMatrixBackground client:only="react" gradient={gradient} />

    {/* Main content layer (above the background) */}
    <div class={MAIN}>
      {/* Header bar */}
      <header class={HEADER_BAR}>
        <a href="/" class={BRAND}>
          {t(locale, "brand")}
        </a>
        <div class="flex items-center gap-2 sm:gap-4">
          <RoleLinks client:load variant="header" />
          <LanguageSelector client:load inline />
        </div>
      </header>

      {/* Page-specific content */}
      <slot />
    </div>
  </body>
</html>