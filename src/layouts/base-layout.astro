---
/**
 * base-layout.astro
 * Common <head>, metadata, global CSS imports, dot matrix background,
 * and header bar. Wraps every page so the background and header
 * appear consistently across the entire app.
 */
import "../styles/global.css";
import { useTranslations, langAttr, localeFromUrl } from "@lib/i18n";
import type { Locale } from "@lib/i18n";
import DotMatrixBackground from "@components/islands/shared/dot-matrix-background";
import LanguageSelector from "@components/islands/shared/language-selector";
import RoleLinks from "@components/islands/shared/role-links";
import type { GradientPreset } from "@components/islands/shared/dot-matrix-background";
import { MAIN, BRAND } from "@lib/classes";

export interface Props {
  title?: string;
  description?: string;
  lang?: Locale;
  /** Dot-matrix background gradient preset. Defaults to `cyan-blue`. */
  gradient?: GradientPreset;
}

const {
  title: titleOverride,
  description: descriptionOverride,
  lang: locale = "en",
  gradient = "cyan-blue",
} = Astro.props;

const lang = langAttr(locale);
const t = useTranslations(locale);
const pageTitle = titleOverride ?? t("site.title");
const pageDescription = descriptionOverride ?? t("site.description");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={pageDescription} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    {/* Dot matrix particle background (fixed, behind all content) */}
    <DotMatrixBackground client:only="react" gradient={gradient} />

    {/* Sticky header bar (above main content) */}
    <header class="sticky top-0 z-20 w-full border-b border-white/10 bg-[#0d0d18]/60 backdrop-blur-sm">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
        <a href="/" class={BRAND}>
          {t("brand")}
        </a>
        <div class="flex items-center gap-2 sm:gap-4">
          <RoleLinks client:load variant="header" />
          <LanguageSelector client:load inline />
        </div>
      </div>
    </header>

    {/* Main content layer (below header) */}
    <div class={MAIN}>
      <slot />
    </div>
  </body>
</html>