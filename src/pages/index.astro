---
/**
 * index.astro
 *
 * Landing page.
 *
 * Centred column (max-width 500px) with, top to bottom:
 *  - Profile picture
 *  - "I am a" terminal card (cycles the developer/creative technologist/
 *    designer/artist roles)
 *  - Mobile phone + email contact
 *  - Role buttons: Developer, Video Editor, Music Artist
 *
 * Background (cyan-blue dot matrix) + header are provided by BaseLayout.
 */
import BaseLayout from "@layouts/base-layout.astro";
import ProfileLanding from "@components/dom/shared/profile-landing.astro";
import { localeFromUrl } from "@lib/i18n";
import type { Locale } from "@lib/i18n";

const locale: Locale = localeFromUrl(Astro.url);
---

<BaseLayout lang={locale}>
  <ProfileLanding gradient="cyan-blue" />
</BaseLayout>
