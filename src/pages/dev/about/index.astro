---
/**
 * about/index.astro
 * Static about page.
 * Background and header are provided by BaseLayout.
 */
import BaseLayout from "@layouts/base-layout.astro";
import { useTranslations, localeFromUrl } from "@lib/i18n";
import type { Locale } from "@lib/i18n";
import { ACCENT_HEADING_LG, BODY } from "@lib/classes";

const locale: Locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);
---

<BaseLayout title={t("about.title")} description={t("about.bio")} lang={locale}>
  <article class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <header class="mb-8">
      <h1 class={ACCENT_HEADING_LG}>
        {t("about.heading")}
      </h1>
    </header>
    <div class={BODY}>
      <p>{t("about.bio")}</p>
    </div>
  </article>
</BaseLayout>