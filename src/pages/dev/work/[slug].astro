---
/**
 * work/[slug].astro
 * Dynamic project detail page. getStaticPaths() enumerates the
 * same dataset used on index.astro.
 *
 * Background and header are provided by BaseLayout.
 */
import BaseLayout from "@layouts/base-layout.astro";
import type { Project } from "@components/dom/desktop/desktop-project-grid.astro";
import { projects } from "@lib/projects";
import {
  BACK_LINK,
  COVER_IMG,
  BODY_MUTED,
  FLEX_HEADER,
} from "@lib/classes";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.title} — htien`} description={`${project.title}, ${project.category} (${project.year})`}>
  <article class="mx-auto flex max-w-4xl flex-col gap-8 px-4 py-8 sm:px-6 lg:px-8">
    <a class={BACK_LINK} href="/dev#work">
      ← Back to work
    </a>
    <header class={FLEX_HEADER}>
      <h1 class="text-2xl font-semibold tracking-tight sm:text-4xl">
        {project.title}
      </h1>
      <p class="font-mono text-base text-[var(--color-fg-muted)]">
        {project.category} — {project.year}
      </p>
    </header>
    <img
      class={COVER_IMG}
      src={project.cover}
      alt={project.title}
      width="1280"
      height="800"
    />
    <div class={BODY_MUTED}>
      <slot />
    </div>
  </article>
</BaseLayout>