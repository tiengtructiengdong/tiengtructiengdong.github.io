---
/**
 * video-editor.astro
 *
 * Video Editor landing page. Same reusable layout as `/`, but with a
 * yellow-orange dot-matrix gradient and video-editor roles cycled in
 * the "I am a" terminal.
 *
 * Background + header are provided by BaseLayout.
 */
import BaseLayout from "@layouts/base-layout.astro";
import ProfileLanding from "@components/dom/shared/profile-landing.astro";
import { localeFromUrl } from "@lib/i18n";
import type { Locale } from "@lib/i18n";

const locale: Locale = localeFromUrl(Astro.url);
---

<BaseLayout
  lang={locale}
  gradient="yellow-orange"
>
  <ProfileLanding
    gradient="yellow-orange"
    accentClassName="text-orange-400"
    textClassName="text-amber-300"
    roles={[
      "i_am_a.video_editor",
      "i_am_a.creative_technologist",
      "i_am_a.designer",
      "i_am_a.artist",
    ]}
  />
</BaseLayout>
