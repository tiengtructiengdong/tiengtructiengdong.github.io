---
/**
 * video-editor.astro
 *
 * Video Editor page.
 *  - Row 1: infinite horizontal carousel of YouTube highlights.
 *  - Row 2: About + Skills (Premiere Pro, DaVinci Resolve, Photoshop).
 *
 * Yellow-orange dot-matrix gradient theme. Background + header (with
 * role buttons + language selector) are provided by BaseLayout.
 */
import BaseLayout from "@layouts/base-layout.astro";
import VideoCarousel from "@components/islands/shared/video-carousel";
import SkillCard from "@components/islands/shared/skill-card";
import AboutCard from "@components/dom/shared/about-card.astro";
import { videoSkillCategories } from "@lib/video-skills";
import { localeFromUrl } from "@lib/i18n";
import type { Locale } from "@lib/i18n";

const locale: Locale = localeFromUrl(Astro.url);
---

<BaseLayout
  lang={locale}
  gradient="yellow-orange"
>
  {/* Row 1: YouTube highlights carousel */}
  <VideoCarousel client:load gradient="yellow-orange" />

  {/* Row 2: About + Skills (stack on mobile, two columns on desktop) */}
  <div class="mt-4 grid grid-cols-1 gap-4 sm:mt-6 sm:gap-6 lg:grid-cols-2">
    <AboutCard
      lang={locale}
      bioKey="about.video_editor_bio"
      accentClassName="text-orange-400"
    />
    <SkillCard
      client:load
      categories={videoSkillCategories}
      accentClassName="text-orange-400"
    />
  </div>
</BaseLayout>

